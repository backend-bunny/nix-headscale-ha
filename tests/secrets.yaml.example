# tests/secrets.yaml.example
#
# Template showing the structure of tests/secrets.yaml (the real, SOPS-encrypted
# file that you must create before deploying to production nodes or running the
# test with real Cloudflare / Backblaze B2 credentials).
#
# HOW TO CREATE secrets.yaml
# ──────────────────────────
#  1. Install prerequisites:
#       nix shell nixpkgs#sops nixpkgs#age
#
#  2. Generate an age key (if you don't already have one):
#       age-keygen -o ~/.config/sops/age/keys.txt
#       # Copy the public key shown in the comment line (age1...)
#
#  3. Update tests/.sops.yaml with your age PUBLIC key:
#       edit tests/.sops.yaml → replace "age1REPLACE_ME" with your public key
#
#  4. Run the automated setup script (generates PKI + creates encrypted YAML):
#       ./tests/gen-test-secrets.sh \
#         --nodes "node1:192.168.1.11,node2:192.168.1.12,node3:192.168.1.13"
#
#     The script will open $EDITOR so you can fill in the B2 and Cloudflare
#     values before encryption.
#
#  5. After creation, add tests/secrets.yaml to git (it is safe to commit —
#     the file is encrypted and only decryptable with your age key).
#     Add tests/secrets.yaml to .gitignore if you prefer to keep it local.
#
# SOPS-NIX USAGE (production nodes)
# ────────────────────────────────────
# Each NixOS node uses sops.secrets to extract the values it needs, e.g.:
#
#   sops.secrets."le-node1-key" = {
#     sopsFile = ./tests/secrets.yaml;
#     key      = "nodes/node1/key";   # YAML key path, '/' -separated
#     mode     = "0400";
#     path     = "/run/secrets/le-node1.key";
#   };
#   sops.secrets."le-ca-cert" = {
#     sopsFile = ./tests/secrets.yaml;
#     key      = "cluster/ca_cert";
#     mode     = "0444";
#     path     = "/run/secrets/le-ca.crt";
#   };
#   sops.secrets."litestream-env" = {
#     sopsFile = ./tests/secrets.yaml;
#     key      = "litestream/env_file";   # systemd EnvironmentFile format
#     mode     = "0400";
#     path     = "/run/secrets/litestream";
#   };
#   sops.secrets."caddy-cf-token" = {
#     sopsFile = ./tests/secrets.yaml;
#     key      = "cloudflare/caddy_env_file";
#     mode     = "0400";
#     path     = "/run/secrets/caddy-cloudflare-token";
#   };
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Cluster mTLS PKI ─────────────────────────────────────────────────────────
cluster:
  # The cluster CA certificate is NOT secret (public key material), but it's
  # convenient to distribute it from the same encrypted bundle so all nodes
  # always get a consistent CA alongside their private keys.
  ca_cert: |
    -----BEGIN CERTIFICATE-----
    REPLACE_WITH_CA_CERTIFICATE_PEM
    -----END CERTIFICATE-----

  # CA private key — keep this ONLY in the secrets file.  It is used once to
  # sign per-node certificates; you do NOT need to deploy it to any node.
  ca_key: |
    -----BEGIN RSA PRIVATE KEY-----
    REPLACE_WITH_CA_KEY_PEM
    -----END RSA PRIVATE KEY-----

nodes:
  node1:
    # Certificate (contains IP SAN 192.168.1.11 + DNS SAN node1)
    cert: |
      -----BEGIN CERTIFICATE-----
      REPLACE_WITH_NODE1_CERT_PEM
      -----END CERTIFICATE-----
    # Private key — deploy ONLY to node1, never to other nodes
    key: |
      -----BEGIN RSA PRIVATE KEY-----
      REPLACE_WITH_NODE1_KEY_PEM
      -----END RSA PRIVATE KEY-----

  node2:
    cert: |
      -----BEGIN CERTIFICATE-----
      REPLACE_WITH_NODE2_CERT_PEM
      -----END CERTIFICATE-----
    key: |
      -----BEGIN RSA PRIVATE KEY-----
      REPLACE_WITH_NODE2_KEY_PEM
      -----END RSA PRIVATE KEY-----

  node3:
    cert: |
      -----BEGIN CERTIFICATE-----
      REPLACE_WITH_NODE3_CERT_PEM
      -----END CERTIFICATE-----
    key: |
      -----BEGIN RSA PRIVATE KEY-----
      REPLACE_WITH_NODE3_KEY_PEM
      -----END RSA PRIVATE KEY-----

# ── Litestream credentials ────────────────────────────────────────────────────
# These are stored as a systemd EnvironmentFile-format string so they can be
# written directly to /run/secrets/litestream and referenced as:
#   services.headscaleHa.litestream.credentialsFile = "/run/secrets/litestream";
litestream:
  # Raw values (used by run-e2e.sh when injecting real credentials into the test)
  b2_key_id: 00REPLACE_WITH_B2_KEY_ID
  b2_application_key: REPLACE_WITH_B2_APPLICATION_KEY
  b2_bucket: REPLACE_WITH_BUCKET_NAME
  b2_endpoint: https://s3.us-west-002.backblazeb2.com  # adjust to your B2 region

  # Systemd EnvironmentFile format — written to /run/secrets/litestream
  # The Litestream docs refer to these as LITESTREAM_ACCESS_KEY_ID and
  # LITESTREAM_SECRET_ACCESS_KEY when using S3/B2.
  env_file: |
    LITESTREAM_ACCESS_KEY_ID=00REPLACE_WITH_B2_KEY_ID
    LITESTREAM_SECRET_ACCESS_KEY=REPLACE_WITH_B2_APPLICATION_KEY

# ── Cloudflare credentials ────────────────────────────────────────────────────
# Two separate env-file entries because Caddy and the watchdog both need the
# token but are different systemd services (different EnvironmentFile owners).
cloudflare:
  # Create a Cloudflare API token with:
  #   Zone → DNS → Edit     (on the zone that hosts your headscale domain)
  api_token: REPLACE_WITH_CLOUDFLARE_API_TOKEN

  # Find the Zone ID on the Overview page of your domain in the CF dashboard
  zone_id: REPLACE_WITH_CLOUDFLARE_ZONE_ID

  # The A record that will be pointed at the current headscale leader's IP.
  # Usually the same as services.headscaleHa.caddy.serverName.
  record_name: headscale.example.com

  # Systemd EnvironmentFile format for Caddy (DNS-01 ACME challenge)
  caddy_env_file: |
    CLOUDFLARE_DNS_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN

  # Systemd EnvironmentFile format for the watchdog (DNS A record failover)
  # (Same token, separate file so each service has minimal access scope)
  watchdog_env_file: |
    CLOUDFLARE_DNS_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
